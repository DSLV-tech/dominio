rules_version = '2';

// Regole di sicurezza delle stanze di Dominio (rooms/{codice}).
// Tutti i giocatori entrano con un accesso anonimo di Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      // chi ha il codice può vedere la stanza (serve per entrarci)
      allow read: if request.auth != null;

      // la crea solo chi ne diventa il padrone, da solo dentro
      allow create: if request.auth != null
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.status == 'lobby'
        && request.resource.data.version == 0;

      allow update: if request.auth != null && (
        // partita: chi è nella stanza scrive lo stato, sempre con versione più alta
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'version', 'writer', 'status', 'updatedAt'])
          && request.resource.data.version > resource.data.version
          && request.resource.data.writer == request.auth.uid)
        ||
        // ingresso: ci si aggiunge solo da sé, finché la partita non è partita
        (resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seats', 'members', 'updatedAt']))
      );

      // chiude la stanza solo chi l'ha creata
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}
