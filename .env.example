# Configurazione Firebase per il gioco online.
# La crea da sola ./scripts/firebase-setup.sh nel file .env.local (non va su git).
# Questi valori non sono segreti: finiscono comunque nel gioco pubblicato;
# la sicurezza la fanno le regole in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Solo per le prove con gli emulatori Firebase (firebase emulators:start):
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
